// base.sets: the `base` superdomain.
//
// Every .sets file imports what it needs from here (`String in base`,
// `union in base`). An implementation exposes this file instead of making
// these symbols special (GUIDE, "`.sets` files are superdomains").
//
// Source adapters reuse these domains; target adapters bind them by the
// meaning given in standards/core/VALUE-MODEL.md, never by the language a
// file came from.

// ---------------------------------------------------------------------
// Universal and empty domains (GUIDE "universal domain", "phi").
// `U` and `Phi` are the only spellings; there are no aliases (VM-LEX-5).
// ---------------------------------------------------------------------

U = { x suchthat x in {x} }
Phi = {}

// The one nothing, declared by a deliberate paradox: it adds no member to
// Phi, and `x in Phi` in a rule never holds (VM-AX-5).
Nothing in Phi

// The two outcomes of a rule. Truth isn't a value (VM-AX-4).
Truef: \\ in U
Falsef: \\ in Phi

// ---------------------------------------------------------------------
// Domain operations (GUIDE "Domain operations built on axioms")
// ---------------------------------------------------------------------

singleton({x suchthat x in U}): {x}
union({A sub U}, {B sub U}): { x suchthat x in A or x in B }
intersect({A sub U}, {B sub U}): { x suchthat x in A and x in B }
difference({A sub U}, {B sub U}): { x suchthat x in A and x not in B }
product2({A sub U}, {B sub U}): { (x, y) suchthat x in A and y in B }

// ---------------------------------------------------------------------
// Top-level axioms. These are pairwise disjoint (VM-AX-1).
// ---------------------------------------------------------------------

String
Integer
Fractional

Real = union(Integer, Fractional)

// ---------------------------------------------------------------------
// Atom rosters (VM-AX-3, VM-AX-4). A nullable domain is
// union(T, {Nothing}); there's no null atom (VM-AX-5).
// ---------------------------------------------------------------------

Boolean = {true, false}
IEEESpecial = {NotANumber, PositiveInfinity, NegativeInfinity, NegativeZero}

// ---------------------------------------------------------------------
// Ranged domains (VM-AX-6, VM-SUB-0)
// ---------------------------------------------------------------------

Natural = { x suchthat x in Integer and x >= 0 }

Int8 = { x suchthat x in Integer and x >= -128 and x <= 127 }
Int16 = { x suchthat x in Integer and x >= -32768 and x <= 32767 }
Int32 = { x suchthat x in Integer and x >= -2147483648 and x <= 2147483647 }
Int64 = { x suchthat x in Integer and x >= -9223372036854775808 and x <= 9223372036854775807 }

Uint8 = { x suchthat x in Integer and x >= 0 and x <= 255 }
Uint16 = { x suchthat x in Integer and x >= 0 and x <= 65535 }
Uint32 = { x suchthat x in Integer and x >= 0 and x <= 4294967295 }
Uint64 = { x suchthat x in Integer and x >= 0 and x <= 18446744073709551615 }

// Finite IEEE-754 values: m * 2 ^ e within the format's bounds.
// m and e are rule-local binders (VM-RULE-2). A whole number has both
// forms here (2 and 2.0), because e >= 0 gives an Integer and e < 0 a
// Fractional (VM-SUB-0, "Both forms").
Binary64Finite = {
    x suchthat
    m in Integer and m > -9007199254740992 and m < 9007199254740992 and
    e in Integer and e >= -1074 and e <= 971 and
    x in singleton(m * 2 ^ e)
}
Binary32Finite = {
    x suchthat
    m in Integer and m > -16777216 and m < 16777216 and
    e in Integer and e >= -149 and e <= 104 and
    x in singleton(m * 2 ^ e)
}

Float64 = union(Binary64Finite, IEEESpecial)
Float32 = union(Binary32Finite, IEEESpecial)

// ---------------------------------------------------------------------
// Described subdomains. `X sub Y` declares X with members drawn from Y
// (GUIDE "Difference between `sub` and `in` in this context");
// VALUE-MODEL.md §5 fixes exactly which members of Y belong to X.
// ---------------------------------------------------------------------

Char sub String

// ---------------------------------------------------------------------
// Collections (VALUE-MODEL.md §6.4)
// ---------------------------------------------------------------------

// Finite sequences as nested pairs ending in the empty tuple:
// [] is (), [a, b] is (a, (b, ())).
EmptySeq = {()}
Seq({T sub U}): union(EmptySeq, { (h, t) suchthat h in T and t in Seq(T) })

// Subdomains of T (VM-SET-1).
SetOf({T sub U}): { s suchthat s sub T }

// Domains of (key, value) pairs with unique keys (VM-MAP-1).
Map({K sub U}, {V sub U}): {
    m suchthat
    m sub product2(K, V) and
    m not in { s suchthat (k, v) in s and (k, w) in s and v not in singleton(w) }
}

// ---------------------------------------------------------------------
// Records (VALUE-MODEL.md §6.1). A record is a set of (key, value)
// tuples; a key can be any value. The empty record is {}. Record domains
// are open unless they say otherwise.
// ---------------------------------------------------------------------

Record = Map(U, U)

// Records whose fields with a key in K, if present, hold a value in V.
OptionalFields({K sub U}, {V sub U}): {
    r suchthat
    r in Record and
    r not in { s suchthat (k, v) in s and k in K and v not in V }
}

// The single-key form of OptionalFields.
OptionalField({k suchthat k in U}, {V sub U}): OptionalFields({k}, V)

// Records with no keys outside K (closed records).
OnlyKeys({K sub U}): { r suchthat r in Record and r sub product2(K, U) }
